# Copy to .env (gitignored) and fill in. Used by docker-compose.yml.
# Generate with: openssl rand -hex 32
JWT_SECRET=
# Admin account created by the seed script on first start
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin.123
CLIENT_URL=http://localhost:8080
CLIENT_PORT=8080
# Baked into the client bundle at build time; relative = same origin via nginx proxy
API_URL=/api
MONGO_DB=mern_ecommerce
